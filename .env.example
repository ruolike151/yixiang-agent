# yixiang 配置示例：复制为 .env 后填写（.env 永不入库）
# 约定：字段名与 env 名一一对应（YIXIANG_MAIN_MODEL → settings.main_model）

# ── 模型（角色路由，§4.2）────────────────────────────────────────────
YIXIANG_MAIN_MODEL=deepseek-flash         # 主对话模型（当前唯一在用的模型；必须支持工具调用）
                                          # 官网在售：deepseek-flash / deepseek-v4-pro；
                                          # deepseek-chat / deepseek-reasoner 已下架，会被 doctor 拦下
YIXIANG_GATE_MODEL=                       # 门控模型；留空 = 同 main（后续建议换最便宜档 / 本地小模型）
YIXIANG_JUDGE_MODEL=                      # judge 裁判；留空 = 同 main（P0 临时，同源自偏好是已知局限）
YIXIANG_UTILITY_MODEL=                    # 巩固 / 摘要 / 润色；留空 = 同 judge
YIXIANG_API_BASE=https://api.deepseek.com/v1   # OpenAI-compatible 端点（DeepSeek / GLM / vLLM / Ollama 通用）
YIXIANG_API_KEY=                          # 必填：密钥只进 .env，trace 与日志里会被脱敏
YIXIANG_JUDGE_API_BASE=                   # judge / utility 换家才填；留空 = 跟 main 同一家
                                          # 本机 Ollama 就写 http://127.0.0.1:11434/v1
YIXIANG_JUDGE_API_KEY=                    # 换了家才填；留空 = 那一端不发密钥（本机端点正是这样）
                                          # 注意：换了家却不填 = 不给密钥，**不会**拿 API_KEY 顶上
YIXIANG_NO_THINK_MODELS=                  # 关掉思考模式的模型名单，逗号分隔，支持前缀通配
                                          # 例：qwen3.5-*  → 请求里带 reasoning_effort=none
                                          # （本地模型不关思考会先把 token 全花在 reasoning 上，content 为空）

# ── 嵌入（本地，零成本，§8.2）───────────────────────────────────────
YIXIANG_EMBED_BACKEND=fastembed           # fastembed | sentence-transformers | api
YIXIANG_EMBED_MODEL=BAAI/bge-small-zh-v1.5   # 512 维

# ── 运行时 ──────────────────────────────────────────────────────────
YIXIANG_DATA_DIR=./data                   # 所有可变状态的根目录（gitignore）

# ── Bangumi（P1，§9.2）──────────────────────────────────────────────
YIXIANG_BANGUMI_TOKEN=                    # 可选：读自己的收藏要它（https://next.bgm.tv/demo/access-token）
                                          # 搜索番剧 / 查评分免 token；填了只会多一条"按我的口味推荐"的能力

# ── QQ 网关（P2，默认关闭；§10.2）────────────────────────────────────
YIXIANG_QQ_ENABLED=0
YIXIANG_QQ_LISTEN=127.0.0.1:8766             # 避开 Web 控制台的 8765（两个都开时不撞车）
YIXIANG_QQ_TOKEN=
YIXIANG_QQ_ALLOWED=                       # 白名单 QQ 号，逗号分隔；空 = 拒绝一切外部消息（安全默认）
YIXIANG_QQ_GROUP_ENABLED=0                # 群消息默认忽略（防第三方注入）

# ── 调度（P0/P1 默认关：推荐走"按需触发"，§10.3）─────────────────────
YIXIANG_SCHEDULER_ENABLED=0
YIXIANG_BRIEF_CRON=0 8 * * *              # P2 生效
YIXIANG_BRIEF_CATCHUP_UNTIL=12:00         # P2 生效
YIXIANG_BRIEF_SINK=cli,file               # P2 生效：cli / file / toast / qq

# ── 记忆与上下文预算（§6.2 / §7.7）──────────────────────────────────
YIXIANG_CONSOLIDATE_EVERY=20              # 每 N 轮触发巩固
YIXIANG_HISTORY_TURNS=10                  # 工作记忆注入的历史轮数
YIXIANG_RETRIEVE_TOP_K=5                  # 门控命中后 facts 条数
YIXIANG_EPISODE_TOP_K=3                   # episodes 条数

# ── Loop 与超时（§5.1 / §4.3）───────────────────────────────────────
YIXIANG_LOOP_MAX_ITER=8                   # 迭代上限（1~20）
YIXIANG_TOOL_RETRY_MAX=2                  # 同一工具连续失败上限
YIXIANG_LLM_TIMEOUT=60                    # 单次 LLM 调用超时（秒）
YIXIANG_GATE_TIMEOUT=8                    # 门控超时（秒），超时即 fail-open

# ── 成本与日志（§15.2）─────────────────────────────────────────────
YIXIANG_BUDGET_CNY_PER_DAY=0.5            # 成本软上限，超限在 ops cost 里告警
YIXIANG_LOG_LEVEL=INFO
